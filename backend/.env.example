# ==============================================================================
# SONAR-INTEL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local runtime configuration.
# NEVER COMMIT REAL PASSWORDS, SECRET KEYS, OR PRIVATE TOKENS.
# ==============================================================================

# ---- Application & Logging ----
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ---- Server Configuration ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- Database Configuration ----
# Leave empty for automatic SQLite fallback (sonar_intel_fallback.db), or provide:
# PostgreSQL with PostGIS: postgresql://postgres:postgres@localhost:5432/sonar_intel
# Or explicit SQLite: sqlite:///path/to/database.db
DATABASE_URL=
DB_CONNECT_TIMEOUT=2
DB_POOL_PRE_PING=false

# ---- Primary Detector Model Provenance & Parameters ----
MODEL_PATH=ml/models/drishti/best_detector.pt
CALIBRATOR_PATH=ml/models/drishti/calibrator.pkl
MODEL_NAME=DRISHTI-YOLOv8s
MODEL_VERSION=baseline-v1
MODEL_SHA256=2f55eec5d8fe6b4737706392e259c02660a8542cddbcbd603f96d606c54cb927
MODEL_SOURCE=https://huggingface.co/rehan9599/drishti-detector
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
NMS_IOU_THRESHOLD=0.35
MIN_BOX_SIZE=15
# Hardware device: leave empty for auto-detection (CUDA if available, else CPU), or 'cpu', 'cuda:0'
DEVICE=

# ---- Sonar Waterfall & Preprocessing Hyperparameters ----
IMAGE_SIZE=640
TILE_SIZE=640
TILE_OVERLAP=0.20
PREPROCESSING_VERSION=drishti-prep-v1
PREPROCESSING_SPECKLE_FILTER=lee
PREPROCESSING_CLAHE=true
LEE_WINDOW_SIZE=5
LEE_NOISE_VAR=0.04
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_X=8
CLAHE_GRID_Y=8
FILTERED_CLASSES=crab_pot

# ---- Composite Priority Scoring Weights & Triage Tiers ----
SCORING_CONFIDENCE_WEIGHT=0.50
SCORING_CONTEXT_WEIGHT=0.25
SCORING_QUALITY_WEIGHT=0.15
SCORING_LOCALIZATION_WEIGHT=0.10
SCORING_HIGH_THRESHOLD=0.72
SCORING_MEDIUM_THRESHOLD=0.48

# ---- Operational Risk Scoring Thresholds ----
RISK_CRITICAL_THRESHOLD=80.0
RISK_HIGH_THRESHOLD=60.0
RISK_MEDIUM_THRESHOLD=35.0

# ---- Multi-Ping Along-Track Tracking Association ----
TRACK_MAX_DISTANCE_M=15.0
TRACK_MAX_PING_GAP=40
TRACK_MIN_OBSERVATIONS=2
TRACK_CONFIRMATION_THRESHOLD=0.75

# ---- Security & File Uploads ----
MAX_UPLOAD_SIZE_MB=250
