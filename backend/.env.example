# ==============================================================================
# SONAR-INTEL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local runtime configuration.
# NEVER COMMIT REAL PASSWORDS, SECRET KEYS, OR PRIVATE TOKENS.
# ==============================================================================

# ---- Server Configuration ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- Database Configuration ----
# Leave empty for automatic SQLite fallback (sonar_intel_fallback.db), or provide:
# PostgreSQL with PostGIS: postgresql://postgres:postgres@localhost:5432/sonar_intel
# Or explicit SQLite: sqlite:///d:/path/to/database.db
DATABASE_URL=

# ---- Model Provenance & Inference Hyperparameters ----
MODEL_PATH=ml/models/dristri/best_detector.pt
MODEL_NAME=DRISHTI-YOLOv8s
MODEL_VERSION=baseline-v1
MODEL_SHA256=2f55eec5d8fe6b4737706392e259c02660a8542cddbcbd603f96d606c54cb927
MODEL_SOURCE=https://huggingface.co/rehan9599/drishti-detector

# Inference settings
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
# Hardware device: leave empty for auto-detection (CUDA if available, else CPU), or specify 'cpu', 'cuda:0'
DEVICE=

# ---- DRISHTI Preprocessing Parameters ----
PREPROCESSING_VERSION=drishti-prep-v1
PREPROCESSING_SPECKLE_FILTER=lee
PREPROCESSING_CLAHE=true
LEE_WINDOW_SIZE=5
LEE_NOISE_VAR=0.04
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_X=8
CLAHE_GRID_Y=8

# Classes filtered from production contact creation (low precision raw classes)
FILTERED_CLASSES=crab_pot
