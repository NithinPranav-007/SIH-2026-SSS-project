# ============================================================
# SONAR-INTEL .gitattributes
# Ensures consistent line endings across Windows/Linux/macOS
# ============================================================

# Default: normalize line endings to LF on commit
* text=auto eol=lf

# Python source files
*.py text eol=lf
*.pyi text eol=lf

# Web / TypeScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Config / Data
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.example text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — no line ending normalization
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.pt binary
*.pth binary
*.onnx binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
